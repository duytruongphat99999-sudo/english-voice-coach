---
import StudyApp from '../islands/StudyApp';
import globalStyles from '../styles/global.css?inline';
import studyStyles from '../styles/study.css?inline';
---

<!doctype html>
<html lang="vi"><head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
  <meta name="theme-color" content="#F6F7F2" />
  <meta name="description" content="Lộ trình hướng tới PTE 90: luyện nghe, nói, đọc, viết theo mức riêng từ A1 đến C2, ngành y và điện tự chọn, có bài học offline." />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta property="og:title" content="English Voice Coach · Tiếng Anh cho mỗi ngày" />
  <meta property="og:description" content="Lộ trình riêng cho bốn kỹ năng. 48 chủ đề. Y và điện tự chọn. Học miễn phí và offline." />
  <link rel="canonical" href="https://english.duytruongphatco.com/" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="/icon.svg" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <title>English Voice Coach · Học tiếng Anh miễn phí mỗi ngày</title>
  <style is:inline set:html={globalStyles + studyStyles} />
</head><body class="public-study">
  <a class="skip-link" href="#study-content">Đến nội dung học</a>
  <StudyApp client:load />
  <noscript><p>Bật JavaScript để luyện tập và lưu tiến độ. Nội dung học miễn phí, không cần tài khoản.</p></noscript>
  <script>
    if ('serviceWorker' in navigator) window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
  </script>
</body></html>
