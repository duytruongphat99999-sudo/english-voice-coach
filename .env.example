# ============================================================
# English Voice Coach — bien moi truong
# Copy file nay thanh .env roi dien gia tri that.
# .env KHONG duoc commit (xem .gitignore).
# ============================================================

# --- Brain: Google Gemini ---------------------------------
# Lay key tai https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model dung cho roleplay + cham diem.
#
# Mac dinh la flash-lite, KHONG phai flash. Do thuc te tu VN ngay 18/08/2026:
#   gemini-3.5-flash-lite : 0.8 - 1.0s   <- on dinh
#   gemini-2.5-flash      : 3 - 12s      (co 503)
#   gemini-3.5-flash      : 9 - 28s      (Google dang qua tai)
# Voi hoi thoai B1/B2 va sua loi ngan, flash-lite du dung; chenh lech toc do
# lon hon chenh lech chat luong rat nhieu. Neu thay phan sua loi hoi hot thi
# doi sang gemini-3.5-flash va chap nhan cham hon.
# Do lai bat cu luc nao: bash scripts/bench-gemini.sh
GEMINI_MODEL=gemini-3.5-flash-lite

# thinkingLevel cua Gemini 3.x: low | high
# Voi task nay "low" du dung va nhanh hon dang ke. Dat "high" neu thay
# phan sua loi hoi hot.
GEMINI_THINKING=low

# Model du phong khi model chinh tra 503 "high demand" (xay ra thuong xuyen).
# Thu lan luot tu trai sang phai, moi model 2 lan. De trong = khong du phong.
GEMINI_MODEL_FALLBACK=gemini-2.5-flash,gemini-3.5-flash

# --- STT / TTS: speaches (self-hosted, OpenAI-compatible) --
# Ten service trong compose, khong phai localhost.
STT_BASE_URL=http://evc-speaches:8000/v1
TTS_BASE_URL=http://evc-speaches:8000/v1

# Model STT. `small` du cho CPU; doi sang `Systran/faster-whisper-medium`
# neu nghe khong chuan, doi lai la cham hon ~2x.
STT_MODEL=Systran/faster-whisper-small

# TTS: speaches yeu cau CA HAI — model id VA voice id.
# Chi dien voice (nhu spec goc) se 404.
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# af_heart (mac dinh, chat luong cao nhat) | af_sky | af_bella | af_nova | bf_emma
# Chay `scripts/tts-voices.sh` de nghe thu roi doi.
TTS_VOICE=af_heart
# Toc do doc. 0.9 de de nghe hon cho nguoi hoc B1.
TTS_SPEED=0.95

# --- Nguoi hoc --------------------------------------------
# Trinh do khoi diem. Gemini se tu day len B2 dan.
LEVEL=B1

# --- Bao mat / tich hop -----------------------------------
# Mat khau vao app va khoa ky cookie phien.
# Dung dien tay — chay: bash scripts/set-password.sh
APP_PASSWORD=
APP_SECRET=

# Token cho GET /today (n8n goi). Sinh bang:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TODAY_TOKEN=

# --- Cloudflare tunnel (chi dung cho docker-compose.cloudflared.yml) ---
# Token cua tunnel tao trong Zero Trust dashboard. Xem README.
CF_TUNNEL_TOKEN_LEARNINGENGLISH=

# --- Khac -------------------------------------------------
TZ=Asia/Ho_Chi_Minh
